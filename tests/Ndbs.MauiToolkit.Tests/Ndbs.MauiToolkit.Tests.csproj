<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!--
		The platform-neutral core of the toolkit lives in Ndbs.MauiToolkit.Core
		(TargetFramework net10.0, no MAUI dependency) and is referenced directly.
		MAUI-specific implementations (Preferences/FileSystem, UI components and DI
		wiring) live in the Ndbs.MauiToolkit project and are intentionally not
		referenced here.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\src\Ndbs.MauiToolkit.Core\Ndbs.MauiToolkit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="NSubstitute" Version="5.3.0" />
	</ItemGroup>

</Project>
