<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!--
		The Ndbs.MauiToolkit library targets platform frameworks (net10.0-android)
		and cannot be project-referenced from a runnable, platform-neutral unit
		test project. The platform-neutral parts of the library (diff utilities,
		environment infrastructure, startup and context helpers) are compiled
		(shared-source) into this test assembly. MAUI-specific defaults
		(Preferences/FileSystem) and DI wiring are excluded.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Diff\DiffTypes.cs" Link="Toolkit\Diff\DiffTypes.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Diff\DiffDescription.cs" Link="Toolkit\Diff\DiffDescription.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Diff\ListDiffAnalyzer.cs" Link="Toolkit\Diff\ListDiffAnalyzer.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Environment infrastructure -->
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Environments\**\*.cs"
		         Link="Toolkit\Environments\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- Dependencies of the environment infrastructure -->
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Context\IUserContext.cs" Link="Toolkit\Context\IUserContext.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Context\UserContext.cs" Link="Toolkit\Context\UserContext.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Messaging\EnvironmentChangingMessage.cs" Link="Toolkit\Messaging\EnvironmentChangingMessage.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Messaging\EnvironmentChangedMessage.cs" Link="Toolkit\Messaging\EnvironmentChangedMessage.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Startup\IKeyValueStore.cs" Link="Toolkit\Startup\IKeyValueStore.cs" />
		<Compile Include="..\..\src\maui-toolkit\Ndbs.MauiToolkit\Workspace\IAppDataRootProvider.cs" Link="Toolkit\Workspace\IAppDataRootProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="NSubstitute" Version="5.3.0" />
	</ItemGroup>

</Project>
