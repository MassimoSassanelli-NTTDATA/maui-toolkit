<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!--
		Ndbs.MauiToolkit.Auth.Ias targets platform frameworks and cannot be
		project-referenced from a runnable, platform-neutral unit test project. The
		platform-neutral units under test (the IAS environment component and its
		configuration) are compiled (shared-source) into this test assembly, together
		with the platform-neutral parts of the base Auth library they depend on. The
		Duende client, the MAUI browsers and the DI wiring require a platform/identity
		provider and are excluded here. The environment abstractions come from the
		platform-neutral Ndbs.MauiToolkit.Core project reference.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Ndbs.MauiToolkit.Auth\**\*.cs" Exclude="..\..\src\Ndbs.MauiToolkit.Auth\Maui\**\*.cs;..\..\src\Ndbs.MauiToolkit.Auth\DependencyInjection\**\*.cs;..\..\src\Ndbs.MauiToolkit.Auth\bin\**\*.cs;..\..\src\Ndbs.MauiToolkit.Auth\obj\**\*.cs" Link="Auth\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\src\Ndbs.MauiToolkit.Auth.Ias\IasIdpComponent.cs" Link="Ias\IasIdpComponent.cs" />
		<Compile Include="..\..\src\Ndbs.MauiToolkit.Auth.Ias\IasConfig.cs" Link="Ias\IasConfig.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Ndbs.MauiToolkit.Core\Ndbs.MauiToolkit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NSubstitute" Version="6.0.0" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

</Project>
