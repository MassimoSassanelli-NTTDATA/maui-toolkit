<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!--
		The Ndbs.MauiToolkit.DynamicTables library targets net10.0 and is
		platform-neutral, so it can be referenced directly by this runnable unit
		test project. The tests exercise the repository against a real SQLite
		database, the CSV parser, the import service and the in-memory cache.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\src\Ndbs.MauiToolkit.DynamicTables\Ndbs.MauiToolkit.DynamicTables.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="NSubstitute" Version="5.3.0" />
		<!-- Override the vulnerable SQLitePCLRaw pulled transitively by EF Core Sqlite (CVE-2025-6965). -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Fixtures\**\*.csv" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
